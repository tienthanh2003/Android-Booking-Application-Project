                        android:text="+10k/h"
                        android:textSize="14sp"
                        android:textColor="#FF9800"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchWhiteboard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- Projector -->
                <LinearLayout
                    android:id="@+id/layoutProjector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="@drawable/bg_addon_item"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📽️"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Máy chiếu"
                            android:textSize="16sp"
                            android:textColor="#333" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Máy chiếu HD cho meeting"
                            android:textSize="12sp"
                            android:textColor="#666" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+25k/h"
                        android:textSize="14sp"
                        android:textColor="#FF9800"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchProjector"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>

            <!-- Duration Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏰ Thời Gian Thuê"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_duration_card"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Số giờ: "
                        android:textSize="16sp"
                        android:textColor="#333" />

                    <!-- DECREASE BUTTON - THIS IS IMPORTANT -->
                    <Button
                        android:id="@+id/btnDecreaseHours"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="−"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:backgroundTint="#E3F2FD"
                        android:textColor="#2196F3"
                        android:layout_marginStart="16dp"
                        app:cornerRadius="24dp" />

                    <!-- HOUR DISPLAY -->
                    <TextView
                        android:id="@+id/tvHours"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#2196F3"
                        android:gravity="center"
                        android:layout_marginHorizontal="12dp" />

                    <!-- INCREASE BUTTON - THIS IS IMPORTANT -->
                    <Button
                        android:id="@+id/btnIncreaseHours"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="+"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:backgroundTint="#E3F2FD"
                        android:textColor="#2196F3"
                        app:cornerRadius="24dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tổng cộng"
                            android:textSize="12sp"
                            android:textColor="#666" />

                        <TextView
                            android:id="@+id/tvTotalPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="200k"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#4CAF50" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Bottom spacing for button -->
            <View
                android:layout_width="match_parent"
                android:layout_height="100dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>

<!-- Fixed Bottom Button -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="#fff"
    android:elevation="8dp"
    android:layout_gravity="bottom">

    <Button
        android:id="@+id/btnAddToCart"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:text="🛒  Thêm vào giỏ hàng"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:backgroundTint="#4CAF50"
        app:cornerRadius="28dp"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btnBookNow"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:text="⚡ Đặt ngay"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:backgroundTint="#FF5722"
        app:cornerRadius="28dp"
        android:layout_marginStart="8dp" />

</LinearLayout>
