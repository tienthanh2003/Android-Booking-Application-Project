<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#F6F8FA">

    <TextView
        android:id="@+id/tvUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tên người dùng"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardForm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardElevation="6dp"
        app:cardCornerRadius="12dp"
        android:background="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/tvUsername"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Họ và tên" android:inputType="textPersonName" android:drawableStart="@android:drawable/ic_menu_edit" android:paddingHorizontal="12dp" />
            <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Email" android:enabled="false" android:inputType="textEmailAddress" android:drawableStart="@android:drawable/ic_dialog_email" android:layout_marginTop="12dp" android:paddingHorizontal="12dp" />
            <EditText android:id="@+id/etPhone" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Số điện thoại" android:inputType="phone" android:drawableStart="@android:drawable/ic_menu_call" android:layout_marginTop="12dp" android:paddingHorizontal="12dp" />
            <EditText android:id="@+id/etGender" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Giới tính" android:inputType="textPersonName" android:drawableStart="@android:drawable/ic_menu_info_details" android:layout_marginTop="12dp" android:paddingHorizontal="12dp" />
            <EditText android:id="@+id/etDob" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Ngày sinh (yyyy-MM-dd)" android:inputType="date" android:drawableStart="@android:drawable/ic_menu_my_calendar" android:layout_marginTop="12dp" android:paddingHorizontal="12dp" />
            <EditText
                android:id="@+id/etRole"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Vai trò"
                android:inputType="text"
                android:enabled="false"
                android:textColorHint="#888888"
                android:textColor="#000000"
                android:drawableStart="@android:drawable/ic_menu_manage"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="12dp" />
            <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Mật khẩu mới" android:inputType="textPassword" android:drawableStart="@android:drawable/ic_lock_idle_lock" android:layout_marginTop="12dp" android:paddingHorizontal="12dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Lưu thay đổi"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/purple_500"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/cardForm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
